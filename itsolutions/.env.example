# Copy this file to .env (and load it with your platform / a tool like
# django-environ, honcho, or your host's env var settings) before deploying.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.co.ke,www.yourdomain.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.co.ke,https://www.yourdomain.co.ke
DJANGO_SECURE_SSL_REDIRECT=True

# Leave DATABASE_URL unset to use local SQLite (fine for dev/small deployments).
# Example for Postgres: postgres://user:password@host:5432/dbname
DATABASE_URL=
