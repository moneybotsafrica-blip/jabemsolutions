{
  "builds": [
    {
      "src": "itsolutions/config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/media/(.*)",
      "dest": "/static/media/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "itsolutions/config/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "itsolutions/config/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings"
  },
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python build.py"
}
